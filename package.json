{
  "name": "tft-archipelago",
  "type": "module",
  "version": "0.5.5",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && node scripts/package-apworld.mjs && tsc -b && vite build",
    "import:tft-data": "node scripts/import-tft-data.mjs",
    "import:tft-icons": "node scripts/import-tft-icons.mjs",
    "package:apworld": "node scripts/package-apworld.mjs",
    "generate:locations": "node scripts/generate-locations.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-electron.mjs",
    "electron": "npm run build && npm run build:electron && electron .",
    "electron:fake-game": "npm run build && npm run build:electron && electron . --fake-game",
    "dist": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "release": "npm run build && npm run build:electron && node scripts/release.mjs"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@fontsource-variable/inter": "5.3.0",
    "@overwolf/types": "^2.3.0",
    "@tabler/icons-react": "3.47.0",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "archipelago.js": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "esbuild": "0.21.5",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "^5.4.10",
    "vitest": "2.1.9"
  },
  "description": "Archipelago client and rule tracker for Teamfight Tactics",
  "author": "Novy",
  "license": "MIT"
}
